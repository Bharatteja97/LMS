<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser E2E Suite" verbose="1" parallel="tests" thread-count="3">

    <!-- Auto-generates a test report in reports/ folder after every run -->
    <listeners>
        <listener class-name="listeners.TestReportListener"/>
    </listeners>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.AccountsTest"/>
            <class name="tests.AccountsDetailsTest"/>
            <class name="tests.PaymentTest"/>
            <class name="tests.SettlementTest"/>
            <class name="tests.ForeclosureTest"/>
            <class name="tests.BalanceTransferTest"/>
            <class name="tests.LedgerTest"/>
            <class name="tests.ScheduleTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.AccountsTest"/>
            <class name="tests.AccountsDetailsTest"/>
            <class name="tests.PaymentTest"/>
            <class name="tests.SettlementTest"/>
            <class name="tests.ForeclosureTest"/>
            <class name="tests.BalanceTransferTest"/>
            <class name="tests.LedgerTest"/>
            <class name="tests.ScheduleTest"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.AccountsTest"/>
            <class name="tests.AccountsDetailsTest"/>
            <class name="tests.PaymentTest"/>
            <class name="tests.SettlementTest"/>
            <class name="tests.ForeclosureTest"/>
            <class name="tests.BalanceTransferTest"/>
            <class name="tests.LedgerTest"/>
            <class name="tests.ScheduleTest"/>
        </classes>
    </test>

</suite>
