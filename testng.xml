<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LOS Test Suite">

    <!-- Automatically generate a test execution report in reports/ folder -->
    <listeners>
        <listener class-name="listeners.TestReportListener"/>
    </listeners>

    <test name="Full End-to-End Flow">
        <classes>
            <class name="tests.CreateLeadTest"/>
            <class name="tests.LeadDetailsTest"/>
            <class name="tests.KycPageTest"/>
            <class name="tests.SendToUnderwritingTest"/>
            <class name="tests.UnderWritingTest"/>
            <class name="tests.ProcessingFeeTest"/>
            <class name="tests.DealerLetterTest"/>
            <class name="tests.DealerConfirmationTest"/>
            <class name="tests.LoanAgreementTest"/>
            <class name="tests.NachRegistrationTest"/>
            <class name="tests.DisbursementTest"/>
            <class name="DashboardTest"/>
        </classes>
    </test>
</suite>
